// Define base parameters
params.path      = '/srv/baia/refdata/plavisca/download/results/data'
params.study     = '39223117'
params.tenx      = 'v3'

// Default values for v3
params.wl        = params.tenx == 'v2' ? '737K-august-2016.txt.gz' : '3M-february-2018.txt'
params.umi_len   = params.tenx == 'v2' ? 10 : 12
params.clip5p    = params.tenx == 'v2' ? '26 0' : '28 0'

// Input files
params.fasta     = './ref/*.fasta'
params.gtf       = './ref/*.gtf'
params.whitelist = "./ref/${params.wl}"
params.fq        = "${params.path}/${params.study}/*_{1,2}.fastq.gz"

// Resources
process {
    cpus = 10
    memory = '16 GB'
    conda = 'bioconda::star=2.7.3a'
}

conda {
    enabled = true
    autoActivate = true
}
